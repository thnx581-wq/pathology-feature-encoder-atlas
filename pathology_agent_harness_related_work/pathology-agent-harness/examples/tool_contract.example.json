{
  "_notice": "纯教学合同，不是某厂商 API schema，也不是已实现工具。",
  "name": "validate_patient_split",
  "inputs": {
    "manifest_path": "DataSet/synthetic_manifest.csv",
    "split_path": "DataSet/synthetic_split.csv"
  },
  "preconditions": [
    "patient_id 存在",
    "只读输入",
    "路径位于获准数据目录"
  ],
  "output_contract": {
    "status": [
      "passed",
      "blocked",
      "error"
    ],
    "patient_overlap": "integer or null on error",
    "error_code": "string or null",
    "artifact_path": "relative path or null"
  },
  "allow_next_training_only_when": "status == passed AND patient_overlap == 0",
  "forbidden_repairs": [
    "猜测标签",
    "把测试患者移动到训练集",
    "修改原始 split 来掩盖泄漏"
  ]
}
